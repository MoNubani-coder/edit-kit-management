# =============================================================================
# Edit Kit Management System - environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================

# --- Database ----------------------------------------------------------------
# Matches docker-compose.yml. Change the password before any shared deployment.
DATABASE_URL="postgresql://ekms:ekms_local_dev@localhost:5432/ekms?schema=public"

# --- Authentication ----------------------------------------------------------
# REQUIRED. Minimum 32 characters. Signs and encrypts the session cookie (JWE);
# rotating it signs everyone out.
AUTH_SECRET=""
# Only needed when the app is behind a proxy that rewrites the host.
# AUTH_URL="https://editkits.internal.example.ae"
AUTH_TRUST_HOST="true"

# --- Session policy ----------------------------------------------------------
# 8 hours absolute, refreshed at most every 15 minutes (idle timeout).
SESSION_MAX_AGE_SECONDS="28800"
SESSION_UPDATE_AGE_SECONDS="900"

# --- Local account lockout ---------------------------------------------------
MAX_LOGIN_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"

# --- Sign-in methods ---------------------------------------------------------
# Local email + password accounts (bcrypt). Keep this on for the emergency
# administrator even after the directory is live; a local account's password
# is always checked here and never sent to the directory.
AUTH_LOCAL_LOGIN_ENABLED="true"
# Corporate directory (LDAP / Active Directory) sign-in. Off until IT has
# supplied the values below; nothing else changes while it is off.
AUTH_LDAP_ENABLED="false"

# --- Directory connection (only read when AUTH_LDAP_ENABLED=true) -----------
# Preferred: ldaps://<host>:636 with LDAP_STARTTLS="false". Plain
# ldap://<host>:389 is accepted ONLY with LDAP_STARTTLS="true", which upgrades
# the connection before anything is sent. The two are alternatives: ldaps://
# together with StartTLS is refused at startup, and the application never sends
# a password over a connection that is neither.
# Certificate validation is always on. To trust an internal CA, point
# LDAP_TLS_CA_FILE at its PEM bundle (or set NODE_EXTRA_CA_CERTS for the process).
# LDAP_URL="ldaps://dc01.corp.example.ae:636"
# LDAP_STARTTLS="false"
# LDAP_TLS_CA_FILE="/etc/ssl/certs/corp-root-ca.pem"
# LDAP_TLS_SERVERNAME=""
LDAP_TIMEOUT_MS="5000"

# --- Directory search --------------------------------------------------------
# LDAP_BASE_DN="DC=corp,DC=example,DC=ae"
# Where user objects live; defaults to LDAP_BASE_DN.
# LDAP_USER_BASE_DN="OU=Staff,DC=corp,DC=example,DC=ae"
# EITHER a read-only service account that looks the user up before their own
# password is verified against their entry...
# LDAP_BIND_DN="CN=svc-editkits,OU=Service Accounts,DC=corp,DC=example,DC=ae"
# LDAP_BIND_PASSWORD=""
# ...OR no service account, in which case the user binds directly as
# <username>@<LDAP_UPN_SUFFIX> and then reads their own entry.
# LDAP_UPN_SUFFIX="corp.example.ae"
# {{username}} is replaced with the RFC 4515-escaped sign-in name.
LDAP_USER_FILTER="(&(objectClass=user)(|(sAMAccountName={{username}})(userPrincipalName={{username}})(mail={{username}})))"

# --- Directory attributes ----------------------------------------------------
# The stable identity the local account is linked by. objectGUID never changes
# when a person is renamed or moved; objectSid is also supported.
LDAP_ID_ATTRIBUTE="objectGUID"
LDAP_USERNAME_ATTRIBUTE="sAMAccountName"
LDAP_NAME_ATTRIBUTE="displayName"
LDAP_EMAIL_ATTRIBUTE="mail"
# Optional. Leave blank if the directory does not carry a staff number.
LDAP_STAFF_ID_ATTRIBUTE="employeeID"
LDAP_GROUP_ATTRIBUTE="memberOf"

# --- Directory accounts in the application -----------------------------------
# false: an administrator creates the account (email, no password) first, and
#        the first directory sign-in links it. Unknown people are refused.
# true:  a first successful sign-in creates the account with LDAP_DEFAULT_ROLE.
LDAP_AUTO_PROVISION="false"
# ENGINEER | EDITOR | VIEWER. ADMIN is not accepted here.
LDAP_DEFAULT_ROLE="VIEWER"
# Optional group -> role mapping, semicolon-separated group DNs. Leave every
# line blank to keep roles under local administration (the default).
# LDAP_ROLE_GROUPS_ADMIN="CN=EKMS-Admins,OU=Groups,DC=corp,DC=example,DC=ae"
# LDAP_ROLE_GROUPS_ENGINEER="CN=Edit-Engineers,OU=Groups,DC=corp,DC=example,DC=ae"
# LDAP_ROLE_GROUPS_EDITOR=""
# LDAP_ROLE_GROUPS_VIEWER=""

# --- Application -------------------------------------------------------------
APP_NAME="Edit Kit Management System"
APP_ORG_NAME="Engineering & Editing Department"
# IANA timezone used for every date rendered in the UI and in PDFs.
APP_TIMEZONE="Asia/Dubai"

# --- File storage ------------------------------------------------------------
# LOCAL | AZURE_BLOB   (only LOCAL is implemented in the MVP)
STORAGE_PROVIDER="LOCAL"
STORAGE_LOCAL_PATH="./storage"
# 10 MB
MAX_UPLOAD_BYTES="10485760"

# --- Seeding -----------------------------------------------------------------
# Used ONLY by `npm run db:seed`. If a password is omitted the seed generates a
# random one and prints it once. The seed refuses to run against NODE_ENV
# =production unless SEED_ALLOW_PRODUCTION=true.
SEED_ADMIN_EMAIL="admin@example.ae"
SEED_ADMIN_PASSWORD=""
SEED_ENGINEER_EMAIL="engineer@example.ae"
SEED_ENGINEER_PASSWORD=""
SEED_EDITOR_EMAIL="editor@example.ae"
SEED_EDITOR_PASSWORD=""
SEED_VIEWER_EMAIL="viewer@example.ae"
SEED_VIEWER_PASSWORD=""
# Forgot a seeded password? Reset it without re-seeding:
#   npm run auth:reset-password -- admin@example.ae
