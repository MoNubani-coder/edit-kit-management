# =============================================================================
# Edit Kit Management System - environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================

# --- Database ----------------------------------------------------------------
# Matches docker-compose.yml. Change the password before any shared deployment.
DATABASE_URL="postgresql://ekms:ekms_local_dev@localhost:5432/ekms?schema=public"

# --- Authentication ----------------------------------------------------------
# REQUIRED. Minimum 32 characters. Rotating this signs everyone out.
AUTH_SECRET=""
# Only needed when the app is behind a proxy that rewrites the host.
# AUTH_URL="https://editkits.internal.example.ae"
AUTH_TRUST_HOST="true"

# --- Session policy ----------------------------------------------------------
# 8 hours absolute, refreshed at most every 15 minutes (idle timeout).
SESSION_MAX_AGE_SECONDS="28800"
SESSION_UPDATE_AGE_SECONDS="900"

# --- Local account lockout ---------------------------------------------------
MAX_LOGIN_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"

# --- Application -------------------------------------------------------------
APP_NAME="Edit Kit Management System"
APP_ORG_NAME="Engineering & Editing Department"
# IANA timezone used for every date rendered in the UI and in PDFs.
APP_TIMEZONE="Asia/Dubai"

# --- File storage ------------------------------------------------------------
# LOCAL | AZURE_BLOB   (only LOCAL is implemented in the MVP)
STORAGE_PROVIDER="LOCAL"
STORAGE_LOCAL_PATH="./storage"
# 10 MB
MAX_UPLOAD_BYTES="10485760"

# --- Seeding -----------------------------------------------------------------
# Used ONLY by `npm run db:seed`. If a password is omitted the seed generates a
# random one and prints it once. The seed refuses to run against NODE_ENV
# =production unless SEED_ALLOW_PRODUCTION=true.
SEED_ADMIN_EMAIL="admin@example.ae"
SEED_ADMIN_PASSWORD=""
SEED_ENGINEER_EMAIL="engineer@example.ae"
SEED_ENGINEER_PASSWORD=""
SEED_EDITOR_EMAIL="editor@example.ae"
SEED_EDITOR_PASSWORD=""
