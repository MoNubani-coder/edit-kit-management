# Deterministic line endings across Windows, WSL and Linux (see DEVELOPMENT.md).
# Text files are normalised to LF in the repository and checked out as LF.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run under cmd.exe / PowerShell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
